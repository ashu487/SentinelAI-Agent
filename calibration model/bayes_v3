"""
bayes.py — SentinelAI reasoning service (v3: dynamic weights + calibration)

Public API (unchanged from v1):
    agent = SentinelAI(read_fn)          # read_fn optional; needed on first boot
    result = agent.step(mq2, mq135, temp, hum, flame, pir, current)
    # or with calibration already on disk:
    agent = SentinelAI()

Environment portability:
    On first boot, a 60-second quiet-baseline capture sets per-sensor
    normalization bounds (p5/p95 of quiet samples, widened by a hazard
    margin), persisted to baseline.json. Subsequent boots load that file.
    Pass force_recalibrate=True to redo it.
"""

import json
import math
import time
from collections import deque
from pathlib import Path

# ============================================================
# 0. CONSTANTS
# ============================================================

HYPOTHESES = ["SAFE", "GAS_LEAK", "OVERHEAT", "FIRE"]

BASE_PRIOR = {"SAFE": 0.70, "GAS_LEAK": 0.10, "OVERHEAT": 0.10, "FIRE": 0.10}

FLAME_BASELINE_DEFAULT = 4095   # clear-room analog reading (active-low)
FLAME_DETECT_DEFAULT   = 800    # reading with flame close to sensor

EWMA_ALPHA = 0.30
FORGET     = 0.97
BASELINE_FILE = Path(__file__).parent / "baseline.json"


# ============================================================
# 1. NORMALIZATION
# ============================================================

def norm(value, lo, hi):
    """Clamp and scale a raw reading into 0..1. Handles lo > hi."""
    if hi == lo:
        return 0.0
    return max(0.0, min(1.0, (value - lo) / (hi - lo)))


# ============================================================
# 2. LIKELIHOOD CURVES (continuous, per-hypothesis)
# ============================================================

def _sigmoid(mid, steepness, floor):
    """p(x) rises from `floor` toward 1 as x passes `mid`."""
    def f(x):
        return floor + (1.0 - floor) / (1.0 + math.exp(-steepness * (x - mid)))
    return f


LIKELIHOODS = {
    "gas": {
        "SAFE":     _sigmoid(0.55, -9.0, 0.03),
        "GAS_LEAK": _sigmoid(0.35,  9.0, 0.05),
        "OVERHEAT": _sigmoid(0.60,  4.0, 0.10),
        "FIRE":     _sigmoid(0.45,  6.0, 0.15),
    },
    "air": {
        "SAFE":     _sigmoid(0.55, -8.0, 0.05),
        "GAS_LEAK": _sigmoid(0.40,  7.0, 0.08),
        "OVERHEAT": _sigmoid(0.65,  3.5, 0.20),
        "FIRE":     _sigmoid(0.55,  5.0, 0.20),
    },
    "temp": {
        "SAFE":     _sigmoid(0.55, -7.0, 0.03),
        "GAS_LEAK": _sigmoid(0.70,  3.0, 0.10),
        "OVERHEAT": _sigmoid(0.45,  6.0, 0.08),
        "FIRE":     _sigmoid(0.50,  6.0, 0.10),
    },
    "current": {
        "SAFE":     _sigmoid(0.60, -6.0, 0.05),
        "GAS_LEAK": _sigmoid(0.80,  2.0, 0.08),
        "OVERHEAT": _sigmoid(0.40,  6.0, 0.10),
        "FIRE":     _sigmoid(0.65,  3.0, 0.15),
    },
    "flame": {
        "SAFE":     _sigmoid(0.30, -14.0, 0.01),
        "GAS_LEAK": _sigmoid(0.70,   2.0, 0.02),
        "OVERHEAT": _sigmoid(0.75,   1.5, 0.05),
        "FIRE":     _sigmoid(0.30,  12.0, 0.02),
    },
}


# ============================================================
# 3. CALIBRATION — one-minute quiet baseline
# ============================================================

class Calibrator:
    """
    60-second quiet-baseline capture. Produces per-channel (lo, hi)
    normalization bounds from empirical p5/p95, widened by a hazard
    margin so normal fluctuations never normalize to 1.0.

    A coarse raw-threshold gate rejects obviously non-quiet samples
    (hot plate on, solvent sprayed, fan on) so the baseline reflects
    the room, not an activity.
    """

    RAW_QUIET = {
        "mq2":     (60,   400),
        "mq135":   (400,  900),
        "temp":    (15,   32),
        "hum":     (20,   80),
        "flame":   (3500, 4095),
        "current": (0.30, 0.90),
    }

    MARGIN = {"mq2": 3.0, "mq135": 2.0, "temp": 2.5, "current": 3.0}

    def __init__(self, duration_s=60, hz=2, path=BASELINE_FILE):
        self.duration_s = duration_s
        self.hz = hz
        self.path = Path(path)
        self.samples = []
        self.rejected = 0

    def _is_quiet(self, raw):
        for k, (lo, hi) in self.RAW_QUIET.items():
            if not (lo <= raw[k] <= hi):
                return False
        return True

    def collect(self, read_fn, progress_fn=None):
        n = int(self.duration_s * self.hz)
        self.samples, self.rejected = [], 0
        for i in range(n):
            raw = read_fn()
            if self._is_quiet(raw):
                self.samples.append(raw)
            else:
                self.rejected += 1
            if progress_fn:
                progress_fn(i / n, len(self.samples), self.rejected)
            time.sleep(1.0 / self.hz)
        return self.samples

    def compute_bounds(self):
        if len(self.samples) < 10:
            raise RuntimeError(
                f"Only {len(self.samples)} quiet samples — baseline unreliable. "
                f"Ensure the room is quiet and retry."
            )
        cols = {k: sorted(s[k] for s in self.samples)
                for k in ("mq2", "mq135", "temp", "current")}
        bounds = {}
        for k, v in cols.items():
            p5  = v[max(0, int(0.05 * len(v)) - 1)]
            p95 = v[min(len(v) - 1, int(0.95 * len(v)))]
            span = max(p95 - p5, 1e-6)
            m = self.MARGIN[k]
            bounds[k] = (p5 - (m - 1) * span / 2,
                         p95 + (m - 1) * span / 2)
        # Flame is special: clear-room is the baseline by construction.
        bounds["flame"] = (FLAME_BASELINE_DEFAULT, FLAME_DETECT_DEFAULT)
        return bounds

    def save(self, bounds):
        self.path.write_text(json.dumps({
            "captured_at":  time.time(),
            "n_samples":    len(self.samples),
            "n_rejected":   self.rejected,
            "duration_s":   self.duration_s,
            "bounds":       {k: list(v) for k, v in bounds.items()},
        }, indent=2))
        return bounds

    def load(self):
        if not self.path.exists():
            return None
        data = json.loads(self.path.read_text())
        return {k: tuple(v) for k, v in data["bounds"].items()}

    def run(self, read_fn, progress_fn=None):
        self.collect(read_fn, progress_fn)
        return self.save(self.compute_bounds())


# ============================================================
# 4. FEATURE EXTRACTION (continuous + EWMA + slope)
# ============================================================

class FeatureExtractor:
    def __init__(self, bounds):
        self.b = bounds
        self.smoothed = {}
        self.prev = {}
        self.slope = {}

    def _smooth(self, key, raw):
        if key not in self.smoothed:
            self.smoothed[key] = raw
        else:
            self.smoothed[key] = EWMA_ALPHA * raw + (1 - EWMA_ALPHA) * self.smoothed[key]
        prev = self.prev.get(key, self.smoothed[key])
        self.slope[key] = self.smoothed[key] - prev
        self.prev[key] = self.smoothed[key]
        return self.smoothed[key]

    def extract(self, mq2, mq135, temp, hum, flame, pir, current):
        raw = {
            "gas":     norm(mq2,     *self.b["mq2"]),
            "air":     norm(mq135,   *self.b["mq135"]),
            "temp":    norm(temp,    *self.b["temp"]),
            "current": norm(current, *self.b["current"]),
            "flame":   norm(flame,   *self.b["flame"]),
        }
        f = {k: self._smooth(k, v) for k, v in raw.items()}
        f["gas_slope"]  = self.slope["gas"]
        f["temp_slope"] = self.slope["temp"]
        f["human"]      = (pir == 1)
        f["humidity"]   = hum
        return f


# ============================================================
# 5. SENSOR HEALTH (dynamic per-sensor reliability weights)
# ============================================================

class SensorHealth:
    WINDOW = 20
    STUCK_RAIL = 0.02

    def __init__(self):
        self.hist = {k: deque(maxlen=self.WINDOW) for k in
                     ("gas", "air", "temp", "current", "flame")}
        self.weight = {k: 1.0 for k in self.hist}

    def update(self, f):
        for k in self.hist:
            self.hist[k].append(f[k])
            w = 1.0
            vals = self.hist[k]
            if len(vals) >= self.WINDOW:
                if all(v <= self.STUCK_RAIL or v >= 1 - self.STUCK_RAIL for v in vals):
                    w *= 0.25
                mean = sum(vals) / len(vals)
                var = sum((v - mean) ** 2 for v in vals) / len(vals)
                if var < 1e-5 and k != "flame":
                    w *= 0.5
            self.weight[k] = 0.85 * self.weight[k] + 0.15 * w
        return self.weight


# ============================================================
# 6. WEIGHTED BAYES UPDATE
# ============================================================

def weighted_bayes_update(f, prior, weights):
    log_post = {h: math.log(max(prior[h], 1e-12)) for h in HYPOTHESES}
    for sensor, table in LIKELIHOODS.items():
        x = f[sensor]
        w = weights.get(sensor, 1.0)
        for h in HYPOTHESES:
            log_post[h] += w * math.log(max(table[h](x), 1e-6))
    m = max(log_post.values())
    exps = {h: math.exp(v - m) for h, v in log_post.items()}
    Z = sum(exps.values())
    return {h: exps[h] / Z for h in HYPOTHESES}


# ============================================================
# 7. CONTEXT-GATED, STRENGTH-SCALED RULES
# ============================================================

def rule_evidence(f, weights):
    ev = {h: 1.0 for h in HYPOTHESES}
    fired = []

    def boost(h, amount, name):
        if amount > 0.01:
            ev[h] *= (1.0 + amount)
            fired.append(f"{name}({amount:.2f})")

    r1 = max(0.0, f["gas"] - 0.20) / 0.80 * weights["gas"]
    boost("GAS_LEAK", 3.0 * r1, "R1:gas")

    r2 = min(f["air"], f["gas"]) * weights["air"] * weights["gas"]
    boost("GAS_LEAK", 2.0 * r2, "R2:air+gas")

    ctx = 1.0 if (f["current"] > 0.35 or f["human"]) else 0.35
    r3 = max(0.0, f["temp"] - 0.35) / 0.65 * weights["temp"] * ctx
    boost("OVERHEAT", 3.0 * r3, "R3:temp")

    r4 = min(f["current"], f["temp"]) * weights["current"] * weights["temp"]
    boost("OVERHEAT", 2.0 * r4, "R4:I+T")

    r5 = f["flame"] * max(0.0, f["temp"] - 0.30) / 0.70 * weights["flame"]
    boost("FIRE", 4.0 * r5, "R5:flame+heat")

    r6 = min(f["gas"], f["flame"]) * weights["gas"] * weights["flame"]
    boost("FIRE", 5.0 * r6, "R6:ignition")

    if f["human"] and (f["gas"] > 0.30 or f["flame"] > 0.5):
        fired.append("R7:human_at_risk")

    if f["gas_slope"] > 0.06:
        boost("GAS_LEAK", 1.5 * weights["gas"], "T1:gas_ramp")
    if f["temp_slope"] > 0.05:
        boost("OVERHEAT", 1.2 * weights["temp"], "T2:heat_ramp")

    return ev, fired


# ============================================================
# 8. TEMPORAL FILTER
# ============================================================

def blend_prior(prev):
    return {h: FORGET * prev[h] + (1 - FORGET) * BASE_PRIOR[h] for h in HYPOTHESES}


# ============================================================
# 9. RISK + HYSTERESIS
# ============================================================

RISK_WEIGHTS = {"FIRE": 0.45, "GAS_LEAK": 0.30, "OVERHEAT": 0.20}


def compute_risk(beliefs, f):
    base = sum(RISK_WEIGHTS[h] * beliefs[h] for h in RISK_WEIGHTS)
    base += 0.05 * (1 - beliefs["SAFE"])
    dom = max(RISK_WEIGHTS, key=lambda h: beliefs[h])
    severity = {"FIRE":     f["flame"],
                "GAS_LEAK": f["gas"],
                "OVERHEAT": max(f["temp"], f["current"])}[dom]
    score = 100 * base * (0.6 + 0.4 * severity)
    if f["human"] and dom != "SAFE":
        score *= 1.25
    return max(0.0, min(100.0, score))


class Hysteresis:
    THRESH = {"GREEN": 0.0, "YELLOW": 25.0, "RED": 50.0}
    EXIT   = {"YELLOW": 18.0, "RED": 42.0}
    ORDER  = ["GREEN", "YELLOW", "RED"]

    def __init__(self):
        self.level = "GREEN"

    def update(self, score):
        i = self.ORDER.index(self.level)
        while i < 2 and score >= self.THRESH[self.ORDER[i + 1]]:
            i += 1
        while i > 0 and score < self.EXIT[self.ORDER[i]]:
            i -= 1
        self.level = self.ORDER[i]
        return self.level


# ============================================================
# 10. ACTIONS (hazard-specific, unchanged semantics)
# ============================================================

def decide_actions(hazard, level, f):
    plan = {"exhaust_fan": False, "buzzer": False, "relay_power": True,
            "red_led": False, "yellow_led": False, "green_led": False}

    if level == "GREEN":
        plan["green_led"] = True
        return plan

    if level == "YELLOW":
        plan["yellow_led"] = True
        if hazard in ("GAS_LEAK", "OVERHEAT"):
            plan["exhaust_fan"] = True
        if hazard == "OVERHEAT":
            plan["relay_power"] = False
        if hazard == "FIRE":
            plan["exhaust_fan"] = False
            plan["relay_power"] = False
        return plan

    plan["red_led"] = True
    plan["buzzer"] = True
    if hazard == "GAS_LEAK":
        plan["exhaust_fan"] = True;   plan["relay_power"] = False
    elif hazard == "OVERHEAT":
        plan["exhaust_fan"] = True;   plan["relay_power"] = False
    elif hazard == "FIRE":
        plan["exhaust_fan"] = False;  plan["relay_power"] = False
    return plan


# ============================================================
# 11. AGENT
# ============================================================

class SentinelAI:
    def __init__(self, read_fn=None, force_recalibrate=False,
                 baseline_path=BASELINE_FILE):
        cal = Calibrator(path=baseline_path)
        bounds = None if force_recalibrate else cal.load()

        if bounds is None:
            if read_fn is None:
                raise RuntimeError(
                    "No baseline file and no read_fn supplied. "
                    "Pass read_fn=<callable returning one raw sample dict> "
                    "to run the 60-second calibration, or place baseline.json "
                    "next to this script."
                )
            print("[SentinelAI] No baseline found — calibrating for 60 s. "
                  "Keep the room quiet.")
            def _progress(frac, kept, rej):
                print(f"\r  calibrating… {frac*100:5.1f}%  kept={kept:3d}  "
                      f"rejected={rej:2d}", end="")
            bounds = cal.run(read_fn, progress_fn=_progress)
            print("\n[SentinelAI] Baseline saved to", cal.path)

        self.bounds = bounds
        self.features = FeatureExtractor(bounds)
        self.health = SensorHealth()
        self.hyst = Hysteresis()
        self.beliefs = dict(BASE_PRIOR)
        self.history = []

    def recalibrate(self, read_fn):
        cal = Calibrator(path=BASELINE_FILE)
        def _progress(frac, kept, rej):
            print(f"\r  recalibrating… {frac*100:5.1f}%  kept={kept:3d}  "
                  f"rejected={rej:2d}", end="")
        bounds = cal.run(read_fn, progress_fn=_progress)
        print()
        self.bounds = bounds
        self.features = FeatureExtractor(bounds)
        self.health = SensorHealth()
        self.hyst = Hysteresis()
        self.beliefs = dict(BASE_PRIOR)
        return bounds

    def step(self, mq2, mq135, temp, hum, flame, pir, current):
        f = self.features.extract(mq2, mq135, temp, hum, flame, pir, current)
        weights = self.health.update(f)

        prior = blend_prior(self.beliefs)
        post = weighted_bayes_update(f, prior, weights)

        ev, fired = rule_evidence(f, weights)
        for h in HYPOTHESES:
            post[h] *= ev[h]
        Z = sum(post.values()) or 1.0
        self.beliefs = {h: post[h] / Z for h in HYPOTHESES}

        hazard = max(self.beliefs, key=self.beliefs.get)
        confidence = self.beliefs[hazard]

        score = compute_risk(self.beliefs, f)
        level = self.hyst.update(score)
        actions = decide_actions(hazard, level, f)

        out = {
            "level":          level,
            "hazard":         hazard,
            "confidence":     round(confidence, 3),
            "risk_score":     round(score, 1),
            "beliefs":        {k: round(v, 3) for k, v in self.beliefs.items()},
            "rules_fired":    fired,
            "sensor_weights": {k: round(v, 2) for k, v in weights.items()},
            "actions":        actions,
        }
        self.history.append({**out, "features": f})
        return out


# ============================================================
# 12. CLI: --demo (replays known scenarios) or interactive
# ============================================================

def _fabricate_read_fn(base_temp=26.0):
    """Fake reader for --demo — quiet lab at the given base_temp."""
    return lambda: {"mq2": 95, "mq135": 528, "temp": base_temp, "hum": 55,
                    "flame": 4095, "pir": 1, "current": 0.66}


def run_demo():
    print("\n" + "#" * 60)
    print("# DEMO — cold room (26 °C) baseline, then a 35 °C room baseline")
    print("#" * 60)

    for base_temp in (26.0, 35.0):
        print(f"\n>>> Calibrating with room at {base_temp} °C …")
        agent = SentinelAI(read_fn=_fabricate_read_fn(base_temp),
                           force_recalibrate=True)

        def show(tag, vals):
            res = agent.step(*vals)
            print(f"  {tag:<28} level={res['level']:<6} "
                  f"hazard={res['hazard']:<9} risk={res['risk_score']:5.1f}  "
                  f"beliefs={res['beliefs']}")

        # Same room, quiet
        show("quiet room",
             (95, 528, base_temp,      55, 4095, 1, 0.66))
        # 3 °C above this room's baseline — should still be SAFE-ish
        show(f"+3 °C (to {base_temp+3:.0f})",
             (95, 528, base_temp + 3,  55, 4095, 1, 0.66))
        # Real gas spike
        show("gas spike (MQ-2 982)",
             (982, 3139, base_temp + 1, 55, 4095, 1, 0.66))
        # Overheating load
        show("overheat (I=1.8, T+15)",
             (300, 700,  base_temp + 15, 40, 4095, 1, 1.8))
        # Fire
        show("fire (flame + heat)",
             (900, 2200, base_temp + 25, 30,  800, 0, 1.2))


def run_interactive():
    # Ask for a read function on first boot so calibration can happen.
    def read_fn():
        raw = input("  calibration sample (mq2 mq135 temp hum flame pir current): ").strip()
        while True:
            try:
                v = raw.split()
                assert len(v) == 7
                return {"mq2": float(v[0]), "mq135": float(v[1]),
                        "temp": float(v[2]), "hum": float(v[3]),
                        "flame": float(v[4]), "pir": int(float(v[5])),
                        "current": float(v[6])}
            except Exception:
                raw = input("  invalid, try again: ").strip()

    try:
        agent = SentinelAI(read_fn=read_fn)
    except RuntimeError as e:
        print(e); return

    print("\nSentinelAI — interactive. Enter 7 values, or 'q'.")
    print("Format: mq2 mq135 temp hum flame pir current")
    while True:
        raw = input("sensors> ").strip()
        if raw.lower() in ("q", "quit", "exit"):
            break
        try:
            v = raw.split()
            if len(v) != 7:
                print("need 7 values"); continue
            mq2, mq135, temp, hum, flame, pir, current = map(float, v)
            res = agent.step(mq2, mq135, temp, hum, int(flame), int(pir), current)
            print(json.dumps(res, indent=2))
        except ValueError:
            print("invalid input")


if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1 and sys.argv[1] == "--demo":
        run_demo()
    elif len(sys.argv) > 1 and sys.argv[1] == "--reset":
        BASELINE_FILE.unlink(missing_ok=True)
        print(f"Removed {BASELINE_FILE}. Next run will recalibrate.")
    else:
        run_interactive()
