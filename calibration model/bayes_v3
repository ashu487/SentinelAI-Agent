"""
sentinel_bridge.py  (v3-minimal)
--------------------------------
Wire-compatible with c1: same topics, same payload shape. The only
change is internal — on first boot the bridge buffers 60 s of telemetry
and uses it to calibrate SentinelAI (baseline.json) before publishing
any verdicts. After calibration, step() runs exactly as in v1/v2.

Topics (unchanged from c1):
  IN       sentinel/sentinel/telemetry   (from ESP32)
  OUT      sentinel/sentinel/agent       (to dashboard)
  COMMAND  sentinel/sentinel/cmd         (manual overrides)
"""

import sys
import os
import json
import time

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import paho.mqtt.client as mqtt
from reasoning.bayes import SentinelAI, Calibrator, BASELINE_FILE

# ------------------------------------------------------------------
# MQTT CONFIG  (unchanged)
# ------------------------------------------------------------------
BROKER_HOST = "10.87.61.232"
BROKER_PORT = 1883
MQTT_USER   = "sentinel"
MQTT_PASS   = "87654321"

DEVICE_ID       = "sentinel"
TOPIC_INPUT     = f"sentinel/{DEVICE_ID}/telemetry"
TOPIC_OUTPUT    = f"sentinel/{DEVICE_ID}/agent"
TOPIC_COMMAND   = f"sentinel/{DEVICE_ID}/cmd"

# ------------------------------------------------------------------
# CALIBRATION WINDOW  (60 s @ 2 Hz — same as Calibrator default)
# ------------------------------------------------------------------
CAL_DURATION_S = 60
CAL_HZ         = 2
CAL_TARGET     = CAL_DURATION_S * CAL_HZ

# ------------------------------------------------------------------
# INTERNAL STATE
# ------------------------------------------------------------------
agent    = None                    # None until calibration completes
_state   = "CALIBRATING"           # "CALIBRATING" | "RUNNING"
_cal_buf = []                      # raw samples collected during calibration
_cal     = None                    # Calibrator instance during collection
_last_cal_progress_print = 0.0

manual = {"buzzer": None, "exhaust": None, "load_power": None}

# ------------------------------------------------------------------
# MQTT CLIENT
# ------------------------------------------------------------------
client = mqtt.Client(client_id="sentinel-bridge")
client.username_pw_set(MQTT_USER, MQTT_PASS)


def on_connect(c, userdata, flags, rc):
    if rc == 0:
        print(f"[bridge] connected to {BROKER_HOST}:{BROKER_PORT}")
        c.subscribe(TOPIC_INPUT)
        c.subscribe(TOPIC_COMMAND)
        print(f"[bridge] listening on {TOPIC_INPUT} and {TOPIC_COMMAND}")
        print(f"[bridge] publishing to {TOPIC_OUTPUT}")
    else:
        print(f"[bridge] connect failed rc={rc}")


# ------------------------------------------------------------------
# FIELD TRANSLATION  (identical to c1)
# ------------------------------------------------------------------
def _f(v, d=0.0):
    try:
        return float(v)
    except (TypeError, ValueError):
        return d


def _i(v, d=0):
    try:
        return int(float(v))
    except (TypeError, ValueError):
        return d


FLAME_LOW  = 1200
FLAME_HIGH = 2500
_last_flame_state = 1


def analog_flame_to_digital(raw):
    global _last_flame_state
    try:
        v = float(raw)
    except (TypeError, ValueError):
        return _last_flame_state
    if v <= FLAME_LOW:
        _last_flame_state = 0
    elif v >= FLAME_HIGH:
        _last_flame_state = 1
    return _last_flame_state


def translate(data: dict) -> dict:
    raw_flame = data.get("flame", 1)
    flame = analog_flame_to_digital(raw_flame)
    return {
        "mq2":     _f(data.get("mq2", 0)),
        "mq135":   _f(data.get("mq135", 0)),
        "temp":    _f(data.get("temperature", data.get("temp", 25))),
        "hum":     _f(data.get("humidity",    data.get("hum", 50))),
        "flame":   flame,
        "pir":     _i(data.get("motion",      data.get("pir", 0))),
        "current": _f(data.get("current", 0)),
    }


# ------------------------------------------------------------------
# CALIBRATION HELPERS
# ------------------------------------------------------------------
def _cal_raw_from(data: dict, reading: dict) -> dict:
    """
    Calibrator expects raw keys including raw-analog flame (3500-4095 in
    a clear room). translate() already collapsed flame to 0/1, so pull
    the original ADC value from `data` here.
    """
    return {
        "mq2":     reading["mq2"],
        "mq135":   reading["mq135"],
        "temp":    reading["temp"],
        "hum":     reading["hum"],
        "flame":   _f(data.get("flame", 4095)),
        "pir":     reading["pir"],
        "current": reading["current"],
    }


def _finish_calibration():
    """
    Called once CAL_TARGET samples have been buffered. Runs the quiet-gate
    + p5/p95 fit, writes baseline.json, and constructs SentinelAI().
    """
    global agent, _state, _cal_buf, _cal

    try:
        bounds = _cal.compute_bounds()
    except RuntimeError as e:
        print(f"[bridge] calibration failed ({e}) — will retry on next telemetry")
        # Keep CALIBRATING; clear buffer so we collect a fresh window.
        _cal_buf.clear()
        _cal.samples.clear()
        _cal.rejected = 0
        return

    _cal.save(bounds)
    agent = SentinelAI(force_recalibrate=False)   # loads the file we just wrote
    _state = "RUNNING"
    print(f"[bridge] calibration complete — "
          f"kept={len(_cal.samples)} rejected={_cal.rejected}")
    _cal_buf = []
    _cal = None


# ------------------------------------------------------------------
# MESSAGE HANDLER
# ------------------------------------------------------------------
def on_message(c, userdata, msg):
    global _state, _cal_buf, _cal, _last_cal_progress_print

    # ---- manual override (unchanged) ----
    if msg.topic == TOPIC_COMMAND:
        try:
            data = json.loads(msg.payload.decode())
        except Exception as e:
            print(f"[bridge] bad cmd JSON: {e}")
            return
        for k in manual:
            if k in data:
                manual[k] = bool(data[k])
        print(f"[bridge] manual override: {manual}")
        return

    # ---- telemetry ----
    if msg.topic == TOPIC_INPUT:
        try:
            data = json.loads(msg.payload.decode())
        except Exception as e:
            print(f"[bridge] bad sensor JSON: {e}")
            return

        if "temperature" not in data and "temp" not in data:
            return

        reading = translate(data)

        # ---- CALIBRATING: buffer only, publish nothing ----
        if _state == "CALIBRATING":
            if _cal is None:
                _cal = Calibrator(path=BASELINE_FILE)
            raw = _cal_raw_from(data, reading)
            if _cal._is_quiet(raw):
                _cal.samples.append(raw)
            else:
                _cal.rejected += 1
            _cal_buf.append(raw)

            # Progress print ~once per second (not on every message)
            now = time.time()
            if now - _last_cal_progress_print > 1.0:
                _last_cal_progress_print = now
                pct = len(_cal_buf) / CAL_TARGET * 100
                print(f"\r[bridge] calibrating… {pct:5.1f}%  "
                      f"kept={len(_cal.samples):3d}  rejected={_cal.rejected:2d}",
                      end="")

            if len(_cal_buf) >= CAL_TARGET:
                print()  # newline after progress line
                _finish_calibration()
            return

        # ---- RUNNING: identical to c1 ----
        try:
            result = agent.step(**{k: reading[k] for k in
                                   ("mq2", "mq135", "temp", "hum",
                                    "flame", "pir", "current")})
        except Exception as e:
            print(f"[bridge] agent.step failed: {e}  reading={reading}")
            return

        publish(reading, result, raw=data)
        return


client.on_connect = on_connect
client.on_message = on_message


def start_mqtt():
    client.connect(BROKER_HOST, BROKER_PORT, keepalive=30)
    client.loop_start()


# ------------------------------------------------------------------
# PUBLISHER  (byte-identical to c1)
# ------------------------------------------------------------------
def publish(reading, result, raw=None):
    level  = result["level"]
    hazard = result["hazard"]
    acts   = result["actions"]

    exhaust = acts.get("exhaust_fan", False)
    buzzer  = acts.get("buzzer", False)
    load_pw = acts.get("relay_power", True)

    if manual["buzzer"] is not None and level != "RED":
        buzzer = manual["buzzer"]
    if manual["exhaust"] is not None and not (level == "RED" and hazard == "FIRE"):
        exhaust = manual["exhaust"]
    if manual["load_power"] is not None and hazard != "OVERHEAT":
        load_pw = manual["load_power"]

    payload = {
        "timestamp":   int(time.time() * 1000),
        "device_id":   DEVICE_ID,

        "level":       level,
        "hazard":      hazard,
        "confidence":  result["confidence"],
        "risk_score":  result["risk_score"],
        "beliefs":     result["beliefs"],
        "rules_fired": result["rules_fired"],

        "actions": {
            "exhaust_fan": bool(exhaust),
            "buzzer":      bool(buzzer),
            "relay_power": bool(load_pw),
            "red_led":     bool(acts.get("red_led",    False)),
            "yellow_led":  bool(acts.get("yellow_led", False)),
            "green_led":   bool(acts.get("green_led",  False)),
        },

        "reading": reading,
        "esp32_raw": raw or {},
    }

    client.publish(TOPIC_OUTPUT, json.dumps(payload), qos=1)
    print(f"[bridge] → {level:6} {hazard:9} risk={result['risk_score']:5}  "
          f"fan={payload['actions']['exhaust_fan']} "
          f"buzzer={payload['actions']['buzzer']}")


# ------------------------------------------------------------------
if __name__ == "__main__":
    start_mqtt()

    if BASELINE_FILE.exists():
        try:
            agent = SentinelAI(force_recalibrate=False)
            _state = "RUNNING"
            print(f"[bridge] loaded {BASELINE_FILE} — running")
        except Exception as e:
            print(f"[bridge] failed to load baseline ({e}) — will recalibrate")
            _state = "CALIBRATING"
    else:
        print(f"[bridge] no {BASELINE_FILE} — calibrating from first "
              f"{CAL_DURATION_S} s of telemetry (keep the room quiet)")
        _state = "CALIBRATING"

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n[bridge] stopping")
        client.loop_stop()
        client.disconnect()
