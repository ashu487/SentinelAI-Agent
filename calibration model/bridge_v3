"""
sentinel_bridge.py  (v3)
------------------------
Reads raw sensor + status JSON from the ESP32, runs it through the
SentinelAI reasoning agent (bayes.py v3 — dynamic weights + 60 s
calibration), and publishes the verdict to a separate topic for the
dashboard.

New in v3 vs c1:
  * If baseline.json is missing on startup, the bridge enters a
    CALIBRATING state, buffers 60 s of live telemetry, and runs the
    calibration itself before publishing any verdicts.
  * Dashboard can trigger a recalibration at any time via the
    `cmd/recalibrate` topic.
  * Calibration progress is published to `calibrate_status` so the
    dashboard can show a progress bar and the final bounds.

Topics:
  IN       sentinel/sentinel/telemetry          (from ESP32)
  OUT      sentinel/sentinel/agent              (to dashboard)
  COMMAND  sentinel/sentinel/cmd                (manual overrides)
  RECAL    sentinel/sentinel/cmd/recalibrate    (trigger 60 s capture)
  CALSTAT  sentinel/sentinel/calibrate_status   (progress + result)
"""

import sys
import os
import json
import time
import threading

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import paho.mqtt.client as mqtt
from reasoning.bayes import SentinelAI, Calibrator, BASELINE_FILE

# ------------------------------------------------------------------
# MQTT CONFIG
# ------------------------------------------------------------------
BROKER_HOST = "10.87.61.232"
BROKER_PORT = 1883
MQTT_USER   = "sentinel"
MQTT_PASS   = "87654321"

DEVICE_ID       = "sentinel"
TOPIC_INPUT     = f"sentinel/{DEVICE_ID}/telemetry"          # ESP32 -> bridge
TOPIC_OUTPUT    = f"sentinel/{DEVICE_ID}/agent"              # bridge -> dashboard
TOPIC_COMMAND   = f"sentinel/{DEVICE_ID}/cmd"                # dashboard -> bridge
TOPIC_RECAL     = f"sentinel/{DEVICE_ID}/cmd/recalibrate"    # trigger calibration
TOPIC_CALSTAT   = f"sentinel/{DEVICE_ID}/calibrate_status"   # progress + result

# ------------------------------------------------------------------
# AGENT — created after calibration
# ------------------------------------------------------------------
agent = None                      # populated once calibration is done
_state_lock = threading.Lock()
_state = "CALIBRATING"            # "CALIBRATING" | "RUNNING"

# Buffer used to accumulate calibration samples while MQTT loop runs.
_cal_buf = []                     # list of raw sample dicts (pre-normalisation)
_cal_target = 60 * 2              # 60 s @ 2 Hz — matches Calibrator default

manual = {"buzzer": None, "exhaust": None, "load_power": None}

# ------------------------------------------------------------------
# MQTT CLIENT
# ------------------------------------------------------------------
client = mqtt.Client(client_id="sentinel-bridge")
client.username_pw_set(MQTT_USER, MQTT_PASS)


def on_connect(c, userdata, flags, rc):
    if rc == 0:
        print(f"[bridge] connected to {BROKER_HOST}:{BROKER_PORT}")
        c.subscribe(TOPIC_INPUT)
        c.subscribe(TOPIC_COMMAND)
        c.subscribe(TOPIC_RECAL)
        print(f"[bridge] listening on {TOPIC_INPUT}, {TOPIC_COMMAND}, {TOPIC_RECAL}")
        print(f"[bridge] publishing to {TOPIC_OUTPUT}")
        _publish_calstat({"state": _state})
    else:
        print(f"[bridge] connect failed rc={rc}")


# ------------------------------------------------------------------
# FIELD TRANSLATION: ESP32 -> SentinelAI.step() args   (unchanged from c1)
# ------------------------------------------------------------------
def _f(v, d=0.0):
    try:
        return float(v)
    except (TypeError, ValueError):
        return d


def _i(v, d=0):
    try:
        return int(float(v))
    except (TypeError, ValueError):
        return d


# FLAME ANALOG -> DIGITAL CONVERSION
FLAME_LOW  = 1200   # below this = flame detected
FLAME_HIGH = 2500   # above this = no flame
_last_flame_state = 1   # 1 = no flame (safe default)


def analog_flame_to_digital(raw):
    """
    Convert a raw analog flame reading into 0 (flame detected) or 1
    (no flame). Uses hysteresis so noise near the threshold doesn't
    cause flip-flopping.
    """
    global _last_flame_state

    try:
        v = float(raw)
    except (TypeError, ValueError):
        return _last_flame_state

    if v <= FLAME_LOW:
        _last_flame_state = 0
    elif v >= FLAME_HIGH:
        _last_flame_state = 1
    return _last_flame_state


def translate(data: dict) -> dict:
    """
    ESP32 flat payload -> SentinelAI.step() keyword args.

    Field name mapping:
      temperature -> temp
      humidity    -> hum
      motion      -> pir
      flame       -> flame   (accepts 0/1 or raw ADC >1)

    flame semantics: 0 = flame detected, 1 = no flame.
    If raw ADC is received (>1), coerce by threshold.
    """
    raw_flame = data.get("flame", 1)
    flame = analog_flame_to_digital(raw_flame)

    return {
        "mq2":     _f(data.get("mq2", 0)),
        "mq135":   _f(data.get("mq135", 0)),
        "temp":    _f(data.get("temperature", data.get("temp", 25))),
        "hum":     _f(data.get("humidity",    data.get("hum", 50))),
        "flame":   flame,
        "pir":     _i(data.get("motion",      data.get("pir", 0))),
        "current": _f(data.get("current", 0)),
    }


def to_cal_raw(reading: dict) -> dict:
    """
    Convert a translated reading back to the raw form Calibrator expects
    (keys: mq2, mq135, temp, hum, flame, pir, current, with flame as raw
    *analog* if available — falls back to the digital state).

    Calibrator.RAW_QUIET for flame expects analog 3500-4095 in a clear
    room, so we prefer the ESP32's raw analog flame when present.
    """
    return {
        "mq2":     reading["mq2"],
        "mq135":   reading["mq135"],
        "temp":    reading["temp"],
        "hum":     reading["hum"],
        "flame":   reading.get("_raw_flame", 4095),   # injected by on_message
        "pir":     reading["pir"],
        "current": reading["current"],
    }


# ------------------------------------------------------------------
# CALIBRATION GLUE
# ------------------------------------------------------------------
def _publish_calstat(obj: dict):
    obj = {"timestamp": int(time.time() * 1000), **obj}
    client.publish(TOPIC_CALSTAT, json.dumps(obj), qos=0)


def _run_calibration(samples=None):
    """
    Build a Calibrator, feed it either a pre-collected buffer or block on
    live telemetry, then construct SentinelAI() from the resulting file.

    Called from on_message (first boot) or a background thread (recal).
    """
    global agent, _state, _cal_buf

    cal = Calibrator(path=BASELINE_FILE)
    t_start = time.time()

    if samples is None:
        # First-boot path: _cal_buf is being filled by on_message; just wait.
        _state = "CALIBRATING"
        _publish_calstat({"state": _state, "progress": 0.0,
                          "target": _cal_target})
        while len(_cal_buf) < _cal_target:
            time.sleep(0.2)
            pct = len(_cal_buf) / _cal_target
            _publish_calstat({
                "state": _state,
                "progress": round(pct, 3),
                "kept": len(cal.samples),
                "collected": len(_cal_buf),
                "rejected": cal.rejected,
            })
        samples = _cal_buf

    # Run the quiet-gate and p5/p95 fit over whatever we've collected.
    cal.samples = []
    cal.rejected = 0
    for s in samples:
        if cal._is_quiet(s):
            cal.samples.append(s)
        else:
            cal.rejected += 1

    try:
        bounds = cal.compute_bounds()
    except RuntimeError as e:
        _publish_calstat({"state": "FAILED", "error": str(e),
                          "kept": len(cal.samples),
                          "rejected": cal.rejected})
        print(f"[bridge] calibration failed: {e}")
        # If we already had an agent from a previous calibration, keep using it.
        if agent is not None:
            _state = "RUNNING"
        return

    cal.save(bounds)

    # SentinelAI v3: pass force_recalibrate=False so it *loads* the file
    # we just wrote rather than calibrating again.
    with _state_lock:
        agent = SentinelAI(force_recalibrate=False)
        _state = "RUNNING"

    elapsed = round(time.time() - t_start, 1)
    print(f"[bridge] calibration complete in {elapsed}s — "
          f"bounds={ {k: [round(v[0], 2), round(v[1], 2)] for k, v in bounds.items()} }")
    _publish_calstat({
        "state":     "READY",
        "elapsed_s": elapsed,
        "kept":      len(cal.samples),
        "rejected":  cal.rejected,
        "bounds":    {k: [round(v[0], 3), round(v[1], 3)]
                      for k, v in bounds.items()},
    })


def _start_recalibration():
    """
    Background thread that collects a fresh 60 s of live telemetry from
    the MQTT stream and re-runs calibration.
    """
    global _cal_buf
    _cal_buf = []
    threading.Thread(target=_run_calibration, args=(None,), daemon=True).start()


# ------------------------------------------------------------------
# MESSAGE HANDLER
# ------------------------------------------------------------------
def on_message(c, userdata, msg):
    global _cal_buf

    # ---- manual override ----
    if msg.topic == TOPIC_COMMAND:
        try:
            data = json.loads(msg.payload.decode())
        except Exception as e:
            print(f"[bridge] bad cmd JSON: {e}")
            return
        for k in manual:
            if k in data:
                manual[k] = bool(data[k])
        print(f"[bridge] manual override: {manual}")
        return

    # ---- recalibrate trigger ----
    if msg.topic == TOPIC_RECAL:
        print("[bridge] recalibration requested by dashboard")
        _start_recalibration()
        return

    # ---- raw telemetry from ESP32 ----
    if msg.topic == TOPIC_INPUT:
        try:
            data = json.loads(msg.payload.decode())
        except Exception as e:
            print(f"[bridge] bad sensor JSON: {e}")
            return

        # Sanity: skip payloads that don't look like the ESP32's
        if "temperature" not in data and "temp" not in data:
            return

        reading = translate(data)
        # Keep the raw analog flame so Calibrator's 3500-4095 gate can use it.
        reading["_raw_flame"] = _f(data.get("flame", 4095))

        # First-boot calibration path: buffer samples until we have 60 s,
        # then run calibration once.
        if _state == "CALIBRATING":
            _cal_buf.append(to_cal_raw(reading))
            if len(_cal_buf) == _cal_target:
                threading.Thread(target=_run_calibration,
                                 args=(list(_cal_buf),), daemon=True).start()
            return

        # Normal path
        try:
            result = agent.step(**{k: reading[k] for k in
                                   ("mq2", "mq135", "temp", "hum",
                                    "flame", "pir", "current")})
        except Exception as e:
            print(f"[bridge] agent.step failed: {e}  reading={reading}")
            return

        publish(reading, result, raw=data)
        return


client.on_connect = on_connect
client.on_message = on_message


def start_mqtt():
    client.connect(BROKER_HOST, BROKER_PORT, keepalive=30)
    client.loop_start()


# ------------------------------------------------------------------
# PUBLISHER  (unchanged shape from c1, plus `bounds` and `slow`)
# ------------------------------------------------------------------
def publish(reading, result, raw=None):
    level  = result["level"]
    hazard = result["hazard"]
    acts   = result["actions"]

    exhaust = acts.get("exhaust_fan", False)
    buzzer  = acts.get("buzzer", False)
    load_pw = acts.get("relay_power", True)

    # manual overrides (subject to safety interlocks)
    if manual["buzzer"] is not None and level != "RED":
        buzzer = manual["buzzer"]
    if manual["exhaust"] is not None and not (level == "RED" and hazard == "FIRE"):
        exhaust = manual["exhaust"]
    if manual["load_power"] is not None and hazard != "OVERHEAT":
        load_pw = manual["load_power"]

    payload = {
        "timestamp":   int(time.time() * 1000),
        "device_id":   DEVICE_ID,

        "level":       level,
        "hazard":      hazard,
        "confidence":  result["confidence"],
        "risk_score":  result["risk_score"],
        "beliefs":     result["beliefs"],
        "rules_fired": result["rules_fired"],

        # v3 extras — dashboard can ignore or surface as a health panel
        "sensor_weights": result.get("sensor_weights", {}),
        "bounds":         result.get("bounds", {}),

        "actions": {
            "exhaust_fan": bool(exhaust),
            "buzzer":      bool(buzzer),
            "relay_power": bool(load_pw),
            "red_led":     bool(acts.get("red_led",    False)),
            "yellow_led":  bool(acts.get("yellow_led", False)),
            "green_led":   bool(acts.get("green_led",  False)),
        },

        "reading": {k: reading[k] for k in
                    ("mq2", "mq135", "temp", "hum",
                     "flame", "pir", "current")},
        "esp32_raw": raw or {},
    }

    client.publish(TOPIC_OUTPUT, json.dumps(payload), qos=1)
    print(f"[bridge] → {level:6} {hazard:9} risk={result['risk_score']:5}  "
          f"fan={payload['actions']['exhaust_fan']} "
          f"buzzer={payload['actions']['buzzer']}")


# ------------------------------------------------------------------
if __name__ == "__main__":
    start_mqtt()

    # Decide initial state: if baseline.json already exists, go straight
    # to RUNNING with a loaded agent. Otherwise wait for telemetry.
    if BASELINE_FILE.exists():
        try:
            agent = SentinelAI(force_recalibrate=False)
            _state = "RUNNING"
            print(f"[bridge] loaded {BASELINE_FILE} — running")
            _publish_calstat({"state": "READY", "source": "file"})
        except Exception as e:
            print(f"[bridge] failed to load baseline: {e} — will recalibrate")
            _state = "CALIBRATING"
    else:
        print(f"[bridge] no {BASELINE_FILE} — waiting for 60 s of telemetry to calibrate")
        _state = "CALIBRATING"
        _publish_calstat({"state": "WAITING_FOR_TELEMETRY",
                          "target": _cal_target})

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n[bridge] stopping")
        client.loop_stop()
        client.disconnect()
